# --- Core services ---
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/voiceagent
REDIS_URL=redis://redis:6379
CLINIC_TIMEZONE=Asia/Dhaka

# --- LiveKit (browser WebRTC) ---
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7890
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
GROQ_API_KEY=your-groq-key-here

# --- Outbound telephony (Twilio Programmable Voice + Media Streams) ---
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=your-twilio-number
# Outbound calls always dial this verified number (trial accounts can't call unverified).
TWILIO_VERIFIED_NUMBER=
# Public base URL Twilio reaches us on (ngrok). Must be an https:// tunnel.
TWILIO_PUBLIC_BASE_URL=
# trial_native (works on trial, <Say>+<Gather>) or media_streams (pipecat over WS)
TWILIO_VOICE_MODE=trial_native
# <Say> voice for trial_native mode, e.g. Polly.Joanna
TWILIO_SAY_VOICE=Polly.Joanna

# --- Legacy LiveKit SIP outbound (requires Twilio upgrade, kept for future) ---
SIP_FROM_NUMBER=
SIP_RINGING_TIMEOUT=45
SIP_MAX_CALL_DURATION=900
SIP_AGENT_JOIN_TIMEOUT=45
OUTBOUND_POLL_INTERVAL=5
OUTBOUND_RETRY_SECONDS=600
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_CALLER=true
